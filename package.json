{
  "name": "americanflyers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p api --noEmit && tsc -p tsconfig.test.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "csp:sync": "node scripts/sync-csp.mjs",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.11.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@neon/neon-js": "^0.10.2",
    "@sentry/browser": "^11.10.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
